{
  "name": "@hedeqiang/dsh-nl2sql",
  "version": "0.11.1",
  "description": "Data Q&A (NL2SQL) for DeepSeek Harness: ask MySQL / PostgreSQL / Elasticsearch / CSV in plain language, charts, dashboards, alerts, IM push and bots (Lark/Feishu, Telegram, WeCom, DingTalk), access control.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "service/*.js",
    "channels/*.js",
    "drivers.js",
    "policy.js",
    "filters.js",
    "im.js",
    "store.js",
    "xlsx.js",
    "analysis.js",
    "lark-bot.js",
    "sqlite-driver.js",
    "sql-guard.js",
    "lib/client.js",
    "lib/client.echarts.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/CHANNELS.md"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@resvg/resvg-js": "2.6.2",
    "echarts": "6.1.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "ssh2": "1.17.0"
  },
  "scripts": {
    "build": "node scripts/build-echarts.mjs",
    "test": "node test/run.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test:fast": "node test/run.mjs --fast",
    "check": "node scripts/build-client.mjs --check && node test/run.mjs --fast"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": "hedeqiang <laravel_code@163.com>",
  "keywords": [
    "bi",
    "deepseek-harness",
    "dingtalk",
    "dsh",
    "dsh-bundle",
    "elasticsearch",
    "feishu",
    "lark",
    "mysql",
    "nl2sql",
    "postgresql",
    "telegram",
    "text-to-sql",
    "wecom"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedeqiang/dsh-nl2sql.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
